# Voice Bot Engine - Environment Configuration

# Groq LLM Configuration (Primary Ultra-Fast Inference Engine)
LLM_PROVIDER=groq
GROQ_API_KEY=replace-me
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini 3.5 Flash LLM (Alternative Provider)
GEMINI_API_KEY=replace-me

# Cartesia Sonic 3.5 TTS & Cartesia Ink STT
CARTESIA_API_KEY=replace-me

# Twilio Telephony Credentials
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Sarvam AI (Indian Voice / Multilingual Marathi & Hindi Fallback)
SARVAM_API_KEY=replace-me

# OpenAI API Key (Optional)
OPENAI_API_KEY=replace-me

# Language & Speech Settings
VOICE_LANGUAGE_CODE=en-IN
STT_TRANSLATE_TO_ENGLISH=true

# Active Microservice Providers
STT_PROVIDER=cartesia
TTS_PROVIDER=cartesia

# Database & Infrastructure Settings
DATABASE_URL=sqlite+aiosqlite:///./voice_agent.db
REDIS_URL=redis://localhost:6379/0
SERVER_URL=https://your-public-tunnel-domain.com
HOST=0.0.0.0
PORT=8055
LOG_LEVEL=INFO
# TypeSafe Jev AI (System 1 Decision Engine for Sub-100ms Routing)
TYPESAFE_API_KEY=replace-me
JEV_MODEL=jev-1.13.0

# Organizations & access
# Super administrators (platform owners): full access to every organization and setting (comma-separated Google sign-in emails).
SUPER_ADMIN_EMAILS=platform.admin@stltech.in,ops.admin@stltech.in,support.admin@stltech.in
# Encrypts organizations' own provider keys and endpoint secrets. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe and backed up: losing it makes stored client keys unreadable. Comma-separate old keys after the new one to rotate.
CREDENTIAL_ENCRYPTION_KEY=

# Gemini 3.8 Live — native speech-to-speech brain for phone calls (replaces STT→LLM→TTS when on).
# Flag-gated: inert unless enabled AND a key is present. Rollback = clear these + recreate backend.
GEMINI_LIVE_ENABLED=false
GEMINI_LIVE_API_KEY=
GEMINI_LIVE_MODEL=models/gemini-3.8-live
GEMINI_LIVE_WORKFLOW_IDS=
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_START_SENS=START_SENSITIVITY_LOW
GEMINI_LIVE_END_SENS=END_SENSITIVITY_HIGH
# Blended $/million-tokens used to estimate per-call cost on the KPI dashboard (audio tokens dominate).
GEMINI_LIVE_COST_PER_MTOKEN=replace-me

# Architect (the console's assistant, and drawing an agent from a description) thinks with the strongest Gemini text model,
# using GEMINI_API_KEY. Models are tried in order; if none can answer, the LLM_PROVIDER engine is the last resort.
# "gemini-pro-latest" follows Google's newest Pro model: name a model to stop that. ARCHITECT_THINKING is LOW, MEDIUM or HIGH.
# One chat turn, or one agent drawn, is a single request and nginx gives up on a request after 60 seconds, so keep the seconds
# below that (a model gets ATTEMPT seconds, all models together get TOTAL) unless nginx's proxy_read_timeout is raised too.
ARCHITECT_MODELS=gemini-pro-latest,gemini-3.8-flash
ARCHITECT_THINKING=HIGH
ARCHITECT_ATTEMPT_SECS=30
ARCHITECT_TOTAL_SECS=50
# Designing a whole agent (desks, documents) is a longer answer, and each written document is its own request; same one-minute limit.
ARCHITECT_DESIGN_ATTEMPT_SECS=40
ARCHITECT_DESIGN_TOTAL_SECS=52
ARCHITECT_DOCUMENT_ATTEMPT_SECS=28
ARCHITECT_DOCUMENT_TOTAL_SECS=50
# The console's Architect panel uses a streamed run (/api/architect/run) that sends something every few seconds, so nginx's minute does
# not apply to it: each model gets longer there.
ARCHITECT_RUN_PLAN_ATTEMPT_SECS=45
ARCHITECT_RUN_PLAN_TOTAL_SECS=70
ARCHITECT_RUN_DESIGN_ATTEMPT_SECS=80
ARCHITECT_RUN_DESIGN_TOTAL_SECS=120
ARCHITECT_RUN_DOCUMENT_ATTEMPT_SECS=50
ARCHITECT_RUN_DOCUMENT_TOTAL_SECS=80

# Every Gemini Live agent is told to sound like a kind, attentive person, and an agent for health care to be gentle and caring
# (backend/app/voice_character.py). Set to false to switch that off.
HUMAN_VOICE_LAYER=true

# Email-based KYC (SMTP) — email the patient the one-tap KYC link with code pre-filled, so they
# don't have to type a spoken URL. Plain SMTP (no paid transactional service needed at clinic volume).
# For Gmail/Workspace use an App Password (not the account password) and port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=STL City Care

# Automatic storage bucket for each new tenant (off by default).
# Needs the cloud service account to be allowed to create buckets (storage.buckets.create, e.g. roles/storage.admin).
AUTO_CREATE_TENANT_BUCKETS=false
TENANT_BUCKET_PREFIX=stl-voicebot
TENANT_BUCKET_LOCATION=us-central1

# Base URL of the dashboard/console, used in member invitation emails.
DASHBOARD_URL=https://voicebot-agent.stldigitaltech.com

# Rate limit for the storage-bucket API (retry/register), per admin.
BUCKET_API_RATE_MAX=5
BUCKET_API_RATE_WINDOW_S=60

# Timeout (seconds) for the Summit ticket-create API call. Lower = less dead air on a slow create.
SUMMIT_CREATE_TIMEOUT_S=15
