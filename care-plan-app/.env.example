# Sanjeevani Virtual Health Store - Environment Configuration Example
GEMINI_API_KEY=replace-me

# MongoDB Configuration (Viewable in MongoDB Compass)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sanjeevani_healthcare

# Voice Bot Push Seam Integration
VOICE_BOT_ENDPOINT_URL=http://localhost:8000/api/v1/prescriptions
VOICE_BOT_API_KEY=replace-me

# Pharmacy pickup: Geoapify Places (free plan: real nearby pharmacy names and addresses)
GEOAPIFY_API_KEY=replace-me

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=replace-me
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Sanjeevani Virtual Health Store

PORT=8000
HOST=0.0.0.0

# Shared password for public preview links; leave empty to turn it off
ACCESS_PASSWORD=

# STL voicebot (follow-up calls and "Call me now"); leave empty to keep the demo assistant
VOICEBOT_URL=
VOICEBOT_API_KEY=
# Comma-separated E.164 numbers that may be called (recommended on a public preview); empty = anyone who asks
VOICEBOT_ALLOWED_NUMBERS=
